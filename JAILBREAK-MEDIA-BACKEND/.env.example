# Optional bearer token — bot must send `Authorization: Bearer <token>`
MEDIA_BACKEND_TOKEN=changeme

# Optional Instagram last-resort fallback (30 free req/mo at instagapi.com)
INSTAGAPI_KEY=your_key_here

# Log each request to stdout (Render logs)
LOG_REQUEST=0

# Per-provider HTTP/network timeout in seconds
NETWORK_TIMEOUT=25

# cookies.txt in this folder is auto-picked-up by yt-dlp (helps Instagram/Facebook)
