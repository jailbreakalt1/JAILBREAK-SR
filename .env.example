# =============================================================================
# JAILBREAK-SR optional environment overrides
# =============================================================================
# Real API keys are ALREADY baked into config.js (they power the brain out of
# the box). This file only exists if you want to override any of them without
# editing code — copy it to .env and change what you need:
#     cp .env.example .env
# The bot loads .env automatically at boot (tools/dotEnv.js) before anything
# reads the values. Every line here is optional; leave it out to use the
# baked-in default from config.js.

# ── The brain (defaults live in config.js) ────────────────────────────────
# NVIDIA_API_KEY=
# NVIDIA_MEDIA_API_KEY=

# ── Weather (https://openweathermap.org/api) ───────────────────────────────
OPEN_WEATHER_API=

# ── Web search (https://firecrawl.dev — free tier, no card) ────────────────
FIRECRAWL_API_KEY=
# Credits per search — 5 → ~200 searches/month on the free tier.
FIRECRAWL_LIMIT=5

# ── Genius lyrics (https://genius.com/api-clients) ─────────────────────────
GENIUS_ACCESS_TOKEN=
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=

# ── Identity / access ─────────────────────────────────────────────────────
# One or more owner numbers (comma separated) for owner-only commands.
OWNER_NUMBERS=263717456159,263738104222
# 'all' = everyone can use the AI, 'owner' = owner only.
AI_ACCESS=all
BOT_NAME=JAILBREAK-SR
PREFIX=.

# ── Optional extras ───────────────────────────────────────────────────────
# Where .update pulls the bot from (GitHub main.zip by default in config.js).
UPDATE_ZIP_URL=https://github.com/jailbreakalt1/JAILBREAK-SR/archive/refs/heads/main.zip

# ── Local media backend (jailbreakdl) ─────────────────────────────────────
# Lives in this repo at downloader-backend/ (single folder, single clone).
# The bot boots it automatically on first start if LOCAL_BACKEND_URL isn't
# reachable. Override these only if you run the backend somewhere unusual.
LOCAL_BACKEND_URL=http://127.0.0.1:30102
# Path to the downloader-backend repo (default: ./downloader-backend).
BACKEND_DIR=

# ── Social media backend (vendored Python: JAILBREAK-MEDIA-BACKEND/) ────────
# Facebook/Instagram/TikTok/Pinterest downloads. Lives in this repo and the bot
# auto-boots it on 127.0.0.1:8000 (its own process, torches nothing). The bot
# talks to it for pasted social links (owner-only). If it's unreachable, the bot
# degrades to the Node backend (yt-dlp only).
MEDIA_BACKEND_URL=http://127.0.0.1:8000
MEDIA_BACKEND_PORT=8000
# Optional bearer — only needed if you start the Python service with
# MEDIA_BACKEND_TOKEN set on that side.
MEDIA_BACKEND_TOKEN=
# Path to the vendored Python backend (default: ./JAILBREAK-MEDIA-BACKEND).
MEDIA_BACKEND_DIR=

# ── Optional extras ───────────────────────────────────────────────────────
# Shazam-style song recognition (auto-shazam commands).
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_HOST=
# Singapore address lookup fallback / generic API key.
ABSTRACT_API_KEY=
# Newsletter destination JID.
NEWSLETTER_JID=
NEWSLETTER_NAME=JAILBREAK HOME
TIMEZONE=Africa/Harare
DISPLAY_CITY=Kwekwe

# ── Autonomous check-in ("miss you" DMs) ─────────────────────────────────
CHECKIN_ENABLED=true
CHECKIN_THRESHOLD_HOURS=24
CHECKIN_COOLDOWN_HOURS=48