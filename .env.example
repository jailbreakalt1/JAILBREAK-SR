# =============================================================================
# JAILBREAK-SR environment template
# =============================================================================
# Self-hosting? Copy this file to `.env` and fill in your own keys:
#     cp .env.example .env
# The bot loads .env automatically at boot (tools/dotEnv.js) before anything
# reads the values, so a bare `git clone` + `npm i` just works — no shell env.
#
# Every value below is optional. Leaving a key blank disables the feature it
# powers (the bot stays up either way).

# ── The brain — put your own keys here (https://build.nvidia.com) ──────────
# Key 1 → SLOT A (main brain) + SLOT C (fast rescue). Required for thinking.
NVIDIA_API_KEY=
# Key 2 → vision/replies + memory summariser (can reuse Key 1 if you must).
NVIDIA_MEDIA_API_KEY=

# ── Weather (https://openweathermap.org/api) ───────────────────────────────
OPEN_WEATHER_API=

# ── Web search (https://firecrawl.dev — free tier, no card) ────────────────
FIRECRAWL_API_KEY=
# Credits per search — 5 → ~200 searches/month on the free tier.
FIRECRAWL_LIMIT=5

# ── Genius lyrics (https://genius.com/api-clients) ─────────────────────────
GENIUS_ACCESS_TOKEN=
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=

# ── Identity / access ─────────────────────────────────────────────────────
# One or more owner numbers (comma separated) for owner-only commands.
OWNER_NUMBERS=263717456159,263738104222
# 'all' = everyone can use the AI, 'owner' = owner only.
AI_ACCESS=all
BOT_NAME=JAILBREAK-SR
PREFIX=.

# ── Local media backend (jailbreakdl) ─────────────────────────────────────
# Where the bot downloads the actual song/video files from. The bot boots
# this automatically on first start if LOCAL_BACKEND_URL isn't reachable.
#   git clone https://github.com/jailbreakalt1/downloader-backend
#   cd downloader-backend && npm i && npm start
LOCAL_BACKEND_URL=http://127.0.0.1:30102
# Path to the downloader-backend repo (only needed if it's somewhere unusual).
BACKEND_DIR=

# ── Optional extras ───────────────────────────────────────────────────────
# Shazam-style song recognition (auto-shazam commands).
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_HOST=
# Singapore address lookup fallback / generic API key.
ABSTRACT_API_KEY=
# Newsletter destination JID.
NEWSLETTER_JID=
NEWSLETTER_NAME=JAILBREAK HOME
TIMEZONE=Africa/Harare
DISPLAY_CITY=Kwekwe

# ── Autonomous check-in ("miss you" DMs) ─────────────────────────────────
CHECKIN_ENABLED=true
CHECKIN_THRESHOLD_HOURS=24
CHECKIN_COOLDOWN_HOURS=48