PORT=30102
# Default bind is 127.0.0.1 (loopback only). Set HOST=0.0.0.0 to expose.
# HOST=0.0.0.0
MAX_MEDIA_SIZE_MB=16
YTDLP_TIMEOUT_MS=40000
MEDIA_TIMEOUT_MS=300000
LOG_LEVEL=info
# COOKIES_FILE=./cookies.txt
# Termux/phones: use the native packages instead of the bundled binaries.
#   pkg install ffmpeg yt-dlp
#   export YTDLP_BINARY=yt-dlp
#   export FFMPEG_BINARY=ffmpeg
# YTDLP_BINARY=yt-dlp
# FFMPEG_BINARY=ffmpeg
# TEMP_ROOT=/tmp/dl-backend
